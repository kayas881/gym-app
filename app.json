{
  "expo": {
    "name": "Gymnos",
    "slug": "my-gym-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "gymnos",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kayas.mygymapp",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Gymnos to access your camera to scan your gym’s join and check-in codes, and to photograph issues you report."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0A0C0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "googleServicesFile": "./google-services.json"
      },
      "package": "com.kayas.mygymapp",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0C0B"
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Gymnos to access your camera to scan your gym’s join and check-in codes, and to photograph issues you report."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Gymnos to access your photos to set a profile picture."
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#B7F34A",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Gymnos to record a set so it can log the exercise, weight and reps."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "af94e66f-5bf8-4f72-ab28-9e6b17b3d6a1"
      }
    },
    "owner": "kayas"
  }
}
