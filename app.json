{
  "expo": {
    "name": "Gym App",
    "slug": "my-gym-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "gym-app",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kayas.mygymapp",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to scan QR codes for gym check-in."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0F0F0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "googleServicesFile": "./google-services.json"
      },
      "package": "com.kayas.mygymapp",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Gym App to access your camera to scan your gym’s join and check-in codes, and to photograph issues you report."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Gym App to access your photos to set a profile picture."
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#00E676",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "af94e66f-5bf8-4f72-ab28-9e6b17b3d6a1"
      }
    },
    "owner": "kayas"
  }
}
